{
    "name": "p7v/smocker-client",
    "description": "Smocker API Client",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Oleksii Plekhanov",
            "email": "alex@p7v.app"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "~8.1.17 || ~8.2.0 || ~8.3.0 || ~8.4.0",
        "cuyz/valinor": "^2.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "symfony/polyfill-php83": "^1.32"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/psr7": "^2.7",
        "phpstan/phpstan": "^2.1.18",
        "vimeo/psalm": "^6.5"
    },
    "autoload": {
        "psr-4": {
            "P7v\\SmockerClient\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.17"
        }
    }
}
